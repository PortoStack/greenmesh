# ========================================================
# GreenMesh Smart Greenhouse - Environment Variables
# คัดลอกไฟล์นี้เป็น .env เพื่อปรับแต่งค่าตามสภาพแวดล้อมของคุณ:
#   cp .env.example .env
# ========================================================

# --------------------------------------------------------
# Golang Server Configuration (Backend)
# --------------------------------------------------------
PORT=8080
CORS_ORIGINS=*
NODE_TIMEOUT_SEC=15

# MQTT Broker Connection
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=greenmesh-server
MQTT_USERNAME=
MQTT_PASSWORD=

# 🤖 Data Simulator Engine (Closed-Loop)
# เปิด/ปิดตัวจำลองข้อมูลอัตโนมัติ (true = เปิด, false = ปิด)
SIMULATOR_ENABLED=true
# ความถี่ในการจำลองค่าเซ็นเซอร์: กำหนดเป็นวินาที (SEC) หรือมิลลิวินาที (MS ระดับ Sub-second)
SIMULATOR_INTERVAL_SEC=1
# SIMULATOR_INTERVAL_MS=500

# --------------------------------------------------------
# 🌐 Next.js Client Configuration (Frontend)
# --------------------------------------------------------
# URL ชี้ไปยัง Golang Fiber Backend (REST/SSE)
NEXT_PUBLIC_API_URL=http://localhost:8080
# URL ชี้ไปยัง Golang Fiber WebSocket Gateway (/api/ws)
NEXT_PUBLIC_WS_URL=ws://localhost:8080
# URL ชี้ไปยัง Mosquitto WebSocket (พอร์ต 9001)
NEXT_PUBLIC_MQTT_URL=ws://localhost:9001
