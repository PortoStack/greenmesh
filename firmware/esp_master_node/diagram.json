{
  "version": 1,
  "author": "GreenMesh",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr_light",
      "top": -90,
      "left": -140,
      "attrs": {}
    },
    {
      "type": "wokwi-slide-switch",
      "id": "sw_water_low",
      "top": 120,
      "left": -120,
      "attrs": { "label": "Water Tank (L:Low Water / R:Normal)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 80,
      "left": 130,
      "attrs": { "resistance": "330" }
    },
    {
      "type": "wokwi-led",
      "id": "led_light",
      "top": 120,
      "left": 150,
      "attrs": { "color": "purple", "label": "Grow Light State" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:3V3", "ldr_light:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "ldr_light:GND", "black", [ "v0" ] ],
    [ "esp:34", "ldr_light:AO", "green", [ "v0" ] ],
    [ "esp:GND.1", "sw_water_low:1", "black", [ "v0" ] ],
    [ "esp:25", "sw_water_low:2", "orange", [ "v0" ] ],
    [ "esp:3V3", "sw_water_low:3", "red", [ "v0" ] ],
    [ "esp:2", "r1:1", "blue", [ "v0" ] ],
    [ "r1:2", "led_light:A", "blue", [ "v0" ] ],
    [ "esp:GND.2", "led_light:C", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
